# ============================================================
# ReUse — Variáveis de Ambiente (Frontend Expo)
# ============================================================
# Copie este arquivo para .env e preencha com seus valores.
# Para overrides locais, crie .env.local (ignorado pelo git).
#
#   cp .env.example .env
#
# No Expo, apenas variáveis com prefixo EXPO_PUBLIC_ ficam
# acessíveis no código JavaScript/TypeScript.
# ============================================================

# ------ API / Backend ------
# URL base da API (com /api no final).
# Produção (Render): https://reuse-api.onrender.com/api
# Dev local: crie .env.local com EXPO_PUBLIC_API_URL=http://SEU_IP:5251/api
EXPO_PUBLIC_API_URL=https://reuse-api.onrender.com/api

# ------ EmailJS (envio de OTP) ------
EXPO_PUBLIC_EMAILJS_SERVICE_ID=
EXPO_PUBLIC_EMAILJS_TEMPLATE_ID=
EXPO_PUBLIC_EMAILJS_PUBLIC_KEY=

# ------ Google Sign-In ------
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# ------ Facebook Login ------
EXPO_PUBLIC_FACEBOOK_APP_ID=
EXPO_PUBLIC_FACEBOOK_CLIENT_TOKEN=
