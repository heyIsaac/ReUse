# ============================================================
# ReUse — Variáveis de Ambiente (Frontend Expo)
# ============================================================
# Copie este arquivo para .env e preencha com seus valores.
# Para overrides locais, crie .env.local (ignorado pelo git).
#
#   cp .env.example .env
#
# --- Mesmas variáveis que produção (build local = binário igual ao da loja) ---
# 1) cp .env.example .env.production
# 2) Preencha .env.production com os MESMOS EXPO_PUBLIC_* do build de produção (EAS/loja).
# 3) yarn ios:prod   ou   yarn android:prod   ou   yarn start:prod
# O arquivo .env.production está no .gitignore (não commitar segredos).
#
# No Expo, apenas variáveis com prefixo EXPO_PUBLIC_ ficam
# acessíveis no código JavaScript/TypeScript.
# ============================================================

# ------ API / Backend ------
# Produção (Render): https://reuse-api.onrender.com/api
# Dev local: crie .env.local com EXPO_PUBLIC_API_URL=http://SEU_IP:5251/api
EXPO_PUBLIC_API_URL=https://reuse-hx4x.onrender.com/api

# ------ Supabase (Auth + Storage) ------
# Encontre em: Supabase Dashboard > Settings > API
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# ------ Google Sign-In ------
# Necessário para o SDK nativo do Google no Android.
# Crie em: Google Cloud Console > APIs & Services > Credentials
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# ------ APIs Externas ------

# ✅ APIs Públicas Gratuitas (SEM necessidade de chave):
# ────────────────────────────────────────────────────────
# • ViaCEP: Busca de endereço por CEP
#   → Endpoint: https://viacep.com.br/ws/{cep}/json/
#   → Usado em: Create Listing, Edit Profile
#   → Sem limites, sem cadastro
#
# • ExchangeRate API v4: Conversão de moedas
#   → Endpoint: https://api.exchangerate-api.com/v4/latest/{BASE}
#   → Usado em: Profile (conversão de economia)
#   → ~1500 req/dia, sem cadastro
#
# • Carbon Calculator: Impacto ambiental (CÁLCULO LOCAL)
#   → Usa fatores de emissão do IPCC/EPA
#   → Usado em: Profile, Listing
#   → Totalmente offline, sem API externa

# Google Maps Distance Matrix API (OPCIONAL - Requer chave)
# Tier gratuito: $200 créditos/mês
# Crie em: https://console.cloud.google.com/apis
# EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# ============================================================
# ESTRATÉGIA: APIs 100% Gratuitas + Cálculos Locais
# ============================================================
# Não precisamos de API keys para as funcionalidades principais!
# Isso simplifica o deploy e evita dependências de serviços pagos.
