# ============================================================
# ReUse — Variáveis de Ambiente (Frontend Expo)
# ============================================================
# Copie este arquivo para .env e preencha com seus valores.
# Para overrides locais, crie .env.local (ignorado pelo git).
#
#   cp .env.example .env
#
# No Expo, apenas variáveis com prefixo EXPO_PUBLIC_ ficam
# acessíveis no código JavaScript/TypeScript.
# ============================================================

# ------ API / Backend ------
# Produção (Render): https://reuse-api.onrender.com/api
# Dev local: crie .env.local com EXPO_PUBLIC_API_URL=http://SEU_IP:5251/api
EXPO_PUBLIC_API_URL=https://reuse-hx4x.onrender.com/api

# ------ Supabase (Auth + Storage) ------
# Encontre em: Supabase Dashboard > Settings > API
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# ------ Google Sign-In ------
# Necessário para o SDK nativo do Google no Android.
# Crie em: Google Cloud Console > APIs & Services > Credentials
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
