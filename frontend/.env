# URL base da API — produção no Render
# Para dev local, crie .env.local com: EXPO_PUBLIC_API_URL=http://SEU_IP:5251/api
EXPO_PUBLIC_API_URL=https://reuse-hx4x.onrender.com/api

# Supabase
EXPO_PUBLIC_SUPABASE_URL=https://SEU_PROJETO.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=coloque_sua_anon_key_aqui

# Google Sign-In (necessário para SDK nativo no Android)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=coloque_seu_google_web_client_id_aqui
