# URL base da API — produção no Render
# Para dev local, crie .env.local com: EXPO_PUBLIC_API_URL=http://SEU_IP:5251/api
EXPO_PUBLIC_API_URL=https://reuse-api.onrender.com/api

# EmailJS
EXPO_PUBLIC_EMAILJS_SERVICE_ID=coloque_seu_service_id_aqui
EXPO_PUBLIC_EMAILJS_TEMPLATE_ID=coloque_seu_template_id_aqui
EXPO_PUBLIC_EMAILJS_PUBLIC_KEY=coloque_sua_public_key_aqui

# Google
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=coloque_sua_public_key_aqui
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=coloque_sua_public_key_aqui

# Facebook
EXPO_PUBLIC_FACEBOOK_APP_ID=coloque_sua_public_key_aqui
EXPO_PUBLIC_FACEBOOK_CLIENT_TOKEN=coloque_sua_public_key_aqui
